{
  "name": "devenv-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent work inside sandboxed software-engineering tasks: browse tasks, run commands in Docker, grade, and diagnose CI logs.",
  "type": "module",
  "bin": {
    "devenv-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "evals",
    "reinforcement-learning",
    "sandbox",
    "docker"
  ],
  "author": "Gachengoh Marugu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TyllerDaniel/devenv-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
